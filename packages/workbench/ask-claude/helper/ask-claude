#!/usr/bin/env python3
"""The ask-claude helper: a model bridge for the Claude Code command line program.

It is one file that imports the standard library and the workbench kit (``wbkit``); the launcher runs a
private copy of it through the kit runner with nothing beside it.

    ask-claude ask [--model <name>] [--effort <level>] [--timeout <seconds>] [--root <path>]
                   [--schema <path>] [--server <name>] [--confine]      the prompt is on standard input

The contract is ``docs/specs/model-bridge.md`` (version 2) and this bridge's own is ``docs/specs/ask-claude.md``. The helper
translates it to one program, ``claude``, in print mode, found on a PATH entry outside the repository, started with
only the file-reading tools (none at all with ``--confine``), no saved session and none of the user's settings, in an
environment built here. It prints one JSON object and keeps no state: it writes nothing in the project, opens no
connection and logs nothing. What the program returns is data: it is classified and copied, never run and never believed.
"""

import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import time
import unicodedata

from wbkit import display, project

VENDOR = "claude"
CONTRACT = 2
PROGRAM = "claude"
MAX_PROMPT = 262144
MAX_REPLY = 262144
MAX_SCHEMA = 65536
MAX_OUTPUT = 1048576
MAX_OBJECT = 2000000
DEFAULT_TIMEOUT = 600
EFFORTS = ("low", "medium", "high")
OPTIONS = ("--model", "--effort", "--timeout", "--root", "--schema", "--server")
FLAGS = ("--confine",)  # an option with no value
# The arguments of every call (docs/specs/ask-claude.md, "The program, found and started"), then the tools: the three that
# read files, or none with `--confine`. The empty value of `--setting-sources` is an argument of its own.
BASE_ARGUMENTS = ("-p", "--output-format", "json", "--no-session-persistence", "--setting-sources", "",
                  "--disable-slash-commands", "--strict-mcp-config", "--permission-mode", "dontAsk")
READ_TOOLS = "Read,Grep,Glob"
_MODEL = r"[A-Za-z0-9][A-Za-z0-9._:-]{0,63}"
_SECONDS = r"[0-9]{1,4}"
_SERVER = r"[a-z0-9][a-z0-9_-]{0,31}"
_KEPT = ("HOME", "XDG_CONFIG_HOME", "USER", "LOGNAME", "LANG", "TZ", "TERM", "TMPDIR")


class Refused(Exception):
    """Nothing was run; the message says why."""


def plain(text, keep=""):
    """`text` without control, format, unassigned and line-separator characters, except those in `keep`."""
    return "".join(c for c in text if c in keep or (unicodedata.category(c)[0] != "C"
                                                    and unicodedata.category(c) not in ("Zl", "Zp")))


def is_inside(path, boundary):
    """True when `path` is `boundary` or below it, whatever links and case spellings lead there. A part of the
    path that does not exist yet is skipped (it cannot be the boundary, but something may be put there later),
    and a part that cannot be examined counts as inside."""
    current = os.path.realpath(path)
    while True:
        try:
            if os.path.samefile(current, boundary):
                return True
        except FileNotFoundError:
            pass
        except OSError:
            return True
        parent = os.path.dirname(current)
        if parent == current:
            return False
        current = parent


def outermost_boundary(start):
    """The outermost ancestor of `start` that holds a `.git` entry. A PATH entry is trusted only when it is
    outside this one, so a repository embedded in another cannot make the outer one look outside."""
    current = os.path.realpath(start)
    found = None
    while True:
        if os.path.lexists(os.path.join(current, ".git")):
            found = current
        parent = os.path.dirname(current)
        if parent == current:
            return found or os.path.realpath(start)
        current = parent


def trusted_entries(boundary):
    """The PATH entries that are absolute, are directories that exist now and are outside the repository: never "",
    "." or a relative one, and never one that is missing or cannot be examined (a missing one that goes up through
    ".." could later name a place inside the repository)."""
    return [entry for entry in os.environ.get("PATH", "").split(os.pathsep)
            if entry and os.path.isabs(entry) and os.path.isdir(entry) and not is_inside(entry, boundary)]


def trusted_which(name, entries, boundary):
    """The first executable file `name` in a trusted entry that does not resolve into the repository."""
    for entry in entries:
        candidate = os.path.join(entry, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK) \
                and not is_inside(candidate, boundary):
            return candidate
    return None


def environment(entries):
    """What the program sees: a short list of the caller's variables, its ``LC_*`` variables and the
    trusted PATH. Nothing else is passed. ``USER`` and ``LOGNAME`` are in the list because the program reports
    "Not logged in" without them even when the machine is signed in."""
    env = {name: os.environ[name] for name in _KEPT if name in os.environ}
    env.update({name: value for name, value in os.environ.items() if name.startswith("LC_")})
    env["PATH"] = os.pathsep.join(entries)
    return env


def parse_options(args):
    """``{option: value}`` for the options in `args`, and ``True`` for a flag: each at most once, each option with a
    value, nothing else."""
    found = {}
    position = 0
    while position < len(args):
        name = args[position]
        if name not in OPTIONS and name not in FLAGS:
            raise Refused("%s is not an option of ask" % display.ascii_text(name)[:60])
        if name in found:
            raise Refused("%s is given twice" % name)
        if name in FLAGS:
            found[name] = True
            position += 1
            continue
        if position + 1 >= len(args):
            raise Refused("%s needs a value" % name)
        found[name] = args[position + 1]
        position += 2
    if "--model" in found and not re.fullmatch(_MODEL, found["--model"]):
        raise Refused("--model is at most 64 characters of letters, digits and ._:- and starts with a "
                      "letter or digit")
    if "--effort" in found and found["--effort"] not in EFFORTS:
        raise Refused("--effort is one of %s" % ", ".join(EFFORTS))
    if "--timeout" in found:
        if not re.fullmatch(_SECONDS, found["--timeout"]) or not 1 <= int(found["--timeout"]) <= 3600:
            raise Refused("--timeout is a whole number of seconds from 1 to 3600")
    if "--server" in found:
        if not re.fullmatch(_SERVER, found["--server"]):
            raise Refused("--server is 1 to 32 characters of a-z, 0-9, _ and - and starts with a letter or digit")
        raise Refused("--server names an endpoint and this bridge starts a program, which has none")
    return found


def read_prompt(stream):
    """The prompt: non-empty UTF-8 text of at most `MAX_PROMPT` bytes."""
    data = stream.read(MAX_PROMPT + 1)
    if not data or not data.strip():
        raise Refused("the prompt on standard input is empty")
    if len(data) > MAX_PROMPT:
        raise Refused("the prompt is larger than %d bytes" % MAX_PROMPT)
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("the prompt is not UTF-8 text")
    return data


def inside_path(base, value, what):
    """The path `value` (absolute, or relative to `base`) as a path below `base` in which no component is
    a link and none is `..`. Raises ``Refused`` for any other path."""
    if not value or "\0" in value:
        raise Refused("%s is not a usable path" % what)
    if value.startswith("-"):  # so that a flag is never read as a path (a --model cannot start with one either)
        raise Refused("%s may not start with a dash; write ./ before a relative path that does" % what)
    if os.path.isabs(value):
        prefix = base.rstrip(os.sep) + os.sep
        if value != base and not value.startswith(prefix):
            raise Refused("%s is outside the project" % what)
        value = value[len(prefix):] if value != base else ""
    parts = [part for part in value.split("/") if part not in ("", ".")]
    if ".." in parts:
        raise Refused("%s names a parent directory" % what)
    current = base
    for part in parts:
        current = os.path.join(current, part)
        try:
            linked = stat.S_ISLNK(os.lstat(current).st_mode)
        except OSError:
            raise Refused("%s does not exist" % what)
        if linked:
            raise Refused("%s has a link in it" % what)
    return current


def working_root(base, value):
    path = base if value is None else inside_path(base, value, "--root")
    if not os.path.isdir(path) or not os.access(path, os.R_OK | os.X_OK):
        raise Refused("--root is not a directory the program can enter")
    if any(part in (".git", ".workbench") for part in os.path.relpath(path, base).split(os.sep)):
        raise Refused("--root may not be inside .git or .workbench")
    return path


def read_schema(base, value):
    """The text of the schema file at `value`: a regular file of at most `MAX_SCHEMA` bytes, with no link in
    its path, holding one JSON object. ``None`` when no schema was given."""
    if value is None:
        return None
    path = inside_path(base, value, "--schema")
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        raise Refused("--schema cannot be opened")
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise Refused("--schema is not a regular file")
        data = os.read(descriptor, MAX_SCHEMA + 1)
    finally:
        os.close(descriptor)
    if len(data) > MAX_SCHEMA:
        raise Refused("--schema is larger than %d bytes" % MAX_SCHEMA)
    if json_object(data) is None:
        raise Refused("--schema is not a JSON object")
    return data.decode("utf-8")


def _no_constant(name):
    raise ValueError("not strict JSON: %s" % name)


def _no_repeat(pairs):
    found = {}
    for key, value in pairs:
        if key in found:
            raise ValueError("not strict JSON: a repeated key")
        found[key] = value
    return found


def json_object(data):
    """The JSON object in `data` (bytes or text), or ``None`` when it is anything else. Strict: no repeated key and
    no ``NaN`` or infinity."""
    try:
        value = json.loads(data if isinstance(data, str) else data.decode("utf-8"),
                           parse_constant=_no_constant, object_pairs_hook=_no_repeat)
    except (ValueError, RecursionError):
        return None
    return value if isinstance(value, dict) else None


def kill(process):
    """Stop the program and anything it started in its own process group."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    try:
        process.kill()
    except ProcessLookupError:
        pass


def run_program(argv, cwd, env, stdin, timeout):
    """Run `argv`; return ``(code, stdout, stderr, over, timed_out)``. Each stream is read to `MAX_OUTPUT`
    bytes and the program is stopped when one passes it, and at `timeout` seconds; the whole process group
    is killed in either case."""
    process = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               cwd=cwd, env=env, start_new_session=True)
    out, err = bytearray(), bytearray()
    over = timed_out = False
    pending = memoryview(stdin)
    try:
        os.set_blocking(process.stdin.fileno(), False)
        with selectors.DefaultSelector() as pipes:
            pipes.register(process.stdout, selectors.EVENT_READ, out)
            pipes.register(process.stderr, selectors.EVENT_READ, err)
            if pending:
                pipes.register(process.stdin, selectors.EVENT_WRITE, None)
            else:
                process.stdin.close()
            deadline = time.monotonic() + timeout
            while (process.stdout in pipes.get_map() or process.stderr in pipes.get_map()) and not over:
                left = deadline - time.monotonic()
                if left <= 0:
                    timed_out = True
                    break
                for key, _ in pipes.select(min(left, 0.2)):
                    if key.data is None:
                        try:
                            pending = pending[os.write(key.fileobj.fileno(), pending[:65536]):]
                        except BlockingIOError:
                            continue
                        except BrokenPipeError:
                            pending = pending[len(pending):]
                        if not pending:
                            pipes.unregister(key.fileobj)
                            process.stdin.close()
                        continue
                    chunk = os.read(key.fileobj.fileno(), 65536)
                    if not chunk:
                        pipes.unregister(key.fileobj)
                    else:
                        key.data.extend(chunk)
                        over = over or len(key.data) > MAX_OUTPUT
        if not timed_out and not over:
            try:
                process.wait(timeout=max(0.0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                timed_out = True
        kill(process)  # also what a program that has exited left running in its group
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            kill(process)
            process.wait()
        return process.returncode, bytes(out[:MAX_OUTPUT]), bytes(err[:MAX_OUTPUT]), over, timed_out
    finally:
        if process.poll() is None:  # an interrupt: the program is in its own session, so it would run on
            kill(process)
            process.wait()
        for pipe in (process.stdin, process.stdout, process.stderr):
            try:
                pipe.close()
            except (OSError, ValueError):
                pass


def count(value):
    """`value` when it is a non-negative whole number the program reported, else ``None``."""
    return value if type(value) is int and 0 <= value <= 10 ** 12 else None


def usage_of(document):
    """The contract's five counts from the program's ``usage`` object (docs/specs/ask-claude.md, "The reply"). The input
    count is the sum of the three the program reports apart, and is ``None`` when any one of them is not a count."""
    usage = document.get("usage") if isinstance(document.get("usage"), dict) else {}
    details = usage.get("output_tokens_details") if isinstance(usage.get("output_tokens_details"), dict) else {}
    parts = [count(usage.get(name)) for name in ("input_tokens", "cache_creation_input_tokens",
                                                 "cache_read_input_tokens")]
    total = None if any(part is None for part in parts) else count(sum(parts))
    return {"input_tokens": total, "output_tokens": count(usage.get("output_tokens")), "total_tokens": None,
            "cached_input_tokens": parts[2], "reasoning_output_tokens": count(details.get("thinking_tokens"))}


def model_of(document, requested):
    """The only key of ``modelUsage`` when it fits the model rule, else the model asked for, else ``None``."""
    used = document.get("modelUsage")
    if isinstance(used, dict) and len(used) == 1:
        name = next(iter(used))
        if isinstance(name, str) and re.fullmatch(_MODEL, name):
            return name
    return requested


MESSAGES = {
    "vendor_unreachable": "claude was not found in a trusted PATH entry",
    "not_started": "claude was found but could not be started",
    "timeout": "claude did not finish in time",
    "unusable_reply": "claude returned no usable reply",
    "reply_too_large": "claude returned more than the bridge accepts",
    "bad_exit": "claude stopped with an error",
}


def failure(error, detail=None, message=None):
    return {"contract": CONTRACT, "ok": False, "vendor": VENDOR, "error": error, "detail": detail,
            "retryable": error == "timeout" or detail == "usage_limit",
            "message": message or MESSAGES[detail or error]}


def outcome(code, stdout, stderr, over, timed_out, requested, schema):
    """The object to print for a finished program."""
    if timed_out:
        return failure("timeout")
    if over:
        return failure("vendor_error", "reply_too_large")
    document = json_object(stdout)
    if code != 0 or (document is not None and document.get("is_error") is True):
        return failure("vendor_error", "bad_exit")
    if document is None or not isinstance(document.get("result"), str):
        return failure("vendor_error", "unusable_reply")
    reply = plain(document["result"], "\n\t")
    if not reply.strip() or (schema is not None and json_object(reply) is None):
        return failure("vendor_error", "unusable_reply")
    if len(reply.encode("utf-8")) > MAX_REPLY:
        return failure("vendor_error", "reply_too_large")
    return {"contract": CONTRACT, "ok": True, "vendor": VENDOR, "model": model_of(document, requested),
            "reply": reply, "usage": usage_of(document)}


def emit(out, document):
    text = json.dumps(document) + "\n"
    if len(text) > MAX_OBJECT:
        text = json.dumps(failure("vendor_error", "reply_too_large")) + "\n"
    out.write(text)
    return 0 if document["ok"] else 1


def arguments(program, options, schema):
    """The program's argument list: the fixed start, the tools, then `--model`, `--effort` and `--json-schema` only
    when given. `--confine` takes the place of the file tools with none."""
    argv = [program, *BASE_ARGUMENTS, "--tools", "" if "--confine" in options else READ_TOOLS]
    if "--model" in options:
        argv += ["--model", options["--model"]]
    if "--effort" in options:
        argv += ["--effort", options["--effort"]]
    if schema is not None:
        argv += ["--json-schema", schema]
    return argv


def ask(args, stdin, cwd, out):
    options = parse_options(args)
    try:
        base = os.path.realpath(project.find_root(cwd))
    except project.ProjectError as exc:
        raise Refused(display.ascii_text(str(exc))[:200])
    prompt = read_prompt(stdin)
    workdir = working_root(base, options.get("--root"))
    schema = read_schema(base, options.get("--schema"))
    timeout = int(options.get("--timeout", DEFAULT_TIMEOUT))
    boundary = outermost_boundary(base)
    entries = trusted_entries(boundary)
    program = trusted_which(PROGRAM, entries, boundary)
    if program is None:
        return emit(out, failure("vendor_unreachable"))
    try:
        finished = run_program(arguments(program, options, schema), workdir, environment(entries), prompt, timeout)
    except OSError:
        return emit(out, failure("vendor_unreachable", message=MESSAGES["not_started"]))
    return emit(out, outcome(*finished, options.get("--model"), schema))


def main(argv, stdin, out, err, cwd):
    """Run one question from `cwd`. Returns the exit code."""
    try:
        if not argv or argv[0] != "ask":
            raise Refused("usage: ask-claude ask [--model <name>] [--effort <level>] [--timeout <seconds>] "
                          "[--root <path>] [--schema <path>] [--server <name>] [--confine], with the prompt on standard input")
        return ask(argv[1:], stdin, cwd, out)
    except Refused as exc:
        err.write("refused: %s\n" % exc)
        return 1
    except OSError as exc:
        err.write("refused: the call could not be started (%s)\n"
                  % display.ascii_text(exc.strerror or "error")[:100])
        return 1


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))  # so the program is stopped
    sys.exit(main(sys.argv[1:], sys.stdin.buffer, sys.stdout, sys.stderr, os.getcwd()))
