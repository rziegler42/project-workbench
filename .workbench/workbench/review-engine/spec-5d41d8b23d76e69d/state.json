      "at": "2026-11-09T16:32:54Z",
      "choice": "applied",
      "earlier": [],
      "finding": "R4-F2",
      "reason": "inventory.json is now untrusted input with size, entry, schema and path caps and an unreadable state, listed in the acceptance tests."
