{
  "name": "ask-ollama",
  "version": "0.1.0",
  "type": "module",
  "description": "A model bridge for an Ollama server: one prompt, one JSON answer, or a batch of texts and their vectors, the server named by the owner's endpoint file.",
  "provides": [
    "model-bridge",
    "text-embedding"
  ],
  "ships": [
    "helper/ask-ollama"
  ],
  "ask_reads": [
    "~/.config/project-workbench/bridge-endpoints.json"
  ],
  "commands": {
    "ask-ollama": {
      "helper": "helper/ask-ollama",
      "runtime": "python",
      "kit": 1,
      "arguments": [
        "ask",
        "check",
        "embed",
        "models"
      ],
      "review_options": {
        "server": {
          "grammar": "name"
        },
        "thinking": {
          "grammar": "onoff",
          "excludes": [
            "effort"
          ]
        },
        "context": {
          "grammar": "count"
        },
        "max-output": {
          "grammar": "count"
        }
      }
    }
  }
}
